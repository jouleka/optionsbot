# Optionsbot secrets. Copy to .env and fill in real values.
# .env is gitignored. Never commit it.

# Telegram bot - created via @BotFather, see IBK-64 for setup walkthrough.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# IBKR credentials are NOT stored here.
# IB Gateway prompts for username/password at startup (or uses its own stored login).
# This codebase never reads or holds the IBKR password.

# Optional overrides (otherwise come from config.toml defaults).
# OPTIONSBOT_IBKR__HOST=127.0.0.1
# OPTIONSBOT_IBKR__PORT=4002
# OPTIONSBOT_IBKR__PAPER=true
